# Pure QM water, PQ + orca_rimp2.py + fake ORCA.
jobtype = qm-md;
nstep = 2;
timestep = 0.1;
force-field = off;
qm_prog = orca;
qm_script = orca_rimp2.py;
orca_file = orca.template;
start_file = water.rst;
file_prefix = water-rimp2;
force_file = water-rimp2.force;
charge_file = water-rimp2.chrg;
overwrite_output = on;
