Geometry = GenFormat {
<<< "geom.gen"
}



Driver = GeometryOptimisation{
    MaxSteps = 0
    Optimizer = SteepestDescent{}
}

Hamiltonian = DFTB {
  charge = 1
  SCC = Yes
  SCCTolerance = 1.0e-5
  MaxSccIterations = 1
  ConvergentSccOnly = No
  ThirdOrderFull = Yes

  ReadInitialCharges = Yes

  HCorrection = Damping { Exponent = 4.00 }

  #HalogenXCorr = Yes

  HubbardDerivs {
  H  = -0.1857
  O  = -0.1575
  K  = -0.0339
  }

  Dispersion = DftD3 {
     Damping = BeckeJohnson {
     a1 = 0.746
     a2 = 4.191
     }
     s6 = 1.0
     s8 = 3.209
     }

  MaxAngularMomentum {
    H  = "s"
    O  = "p"
    K  = "p"
  }

  SlaterKosterFiles = Type2FileNames {
    Prefix = "/path/to/slakos/3ob/skfiles/"
    Separator = "-"
    Suffix = ".skf"
    LowerCaseTypeName = No
  }

  Filling = Fermi {
    Temperature [Kelvin] = 0.0
  }
  mixer = simple{
    mixingparameter = 0.0000000001
  }
}

Options {}

Analysis = {
   MullikenAnalysis = Yes
   PrintForces = Yes
}

ParserOptions {
  ParserVersion = 5
}
