Geometry = GenFormat {
<<< "geom.gen"
}



Driver =  {}

Hamiltonian = DFTB {
  charge = 1
  SCC = Yes
  SCCTolerance = 1.0e-5
  ThirdOrderFull = Yes

  ReadInitialCharges = No

  HCorrection = Damping { Exponent = 4.00 }

  #HalogenXCorr = Yes

  HubbardDerivs {
    # Zn = -0.03
    # Na = -0.0454
  H  = -0.1857
  O  = -0.1575
  K  = -0.0339
  }

  Dispersion = DftD3 {
     Damping = BeckeJohnson {
     a1 = 0.746
     a2 = 4.191
     }
     s6 = 1.0
     s8 = 3.209
     }

  MaxAngularMomentum {
    H  = "s"
    O  = "p"
    K  = "p"
  }

  SlaterKosterFiles = Type2FileNames {
    Prefix = "/path/to/slakos/3ob/skfiles/"
    Separator = "-"
    Suffix = ".skf"
    LowerCaseTypeName = No
  }

  ElectricField = {
     PointCharges = {
     CoordsAndCharges [Angstrom] = DirectRead {
     Records = 30
     File = "pointcharges"
      }
    }
  }


  Filling = Fermi {
    Temperature [Kelvin] = 0.0
  }
}

Options {}


ParserOptions {
  ParserVersion = 5
}
