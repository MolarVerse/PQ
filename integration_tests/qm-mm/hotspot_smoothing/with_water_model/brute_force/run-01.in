#

# General Keywords
jobtype = qmmm-md;
nstep = 2;
timestep = 0.5;

# Thermostat
thermostat = berendsen;
t_relaxation = 0.1;
temp = 298.15;

# MM Keywords
force-field = off;
rcoulomb = 10.0;
water_intra = tip3p;
water_inter = tip3p;
shake-iter = 100;
rattle-iter = 100;

# QM Keywords
qm_prog = dftbplus;
qm_script = dftbplus_periodic_stress;

# Hybrid MD Keywords
smoothing_method = hotspot;
core_radius = 0.0;
layer_radius = 3.8;
smoothing_region_thickness = 0.2;
point_charge_thickness = 15.0;

# File Keywords
overwrite_output = on;
start_file       = input.rst;
file_prefix      = output-md-01;

