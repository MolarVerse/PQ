# MOF-5 FeNNol MD

    # Type of this run
      jobtype = qm-md;
      nstep = 5000;
      timestep = 0.5;
      nreset = 5;
      thermostat = nh-chain;
      start_temp = 1;
      temp = 298.15;
      t_relaxation = 0.1;
      nh-chain_length = 4;
      virial = atomic;

    # QM programm
      qm_prog             = fennol;
      floating_point_type = float;
      gpu_preprocessing   = on;
      #################################################
      fennol_model_path   = /path/to/fenol-model.fnx; # ADJUST THIS!  ################################################


    # Input file
      start_file  = mof5-eq.rst;

    # Output files
      file_prefix = mof5-md-01;

