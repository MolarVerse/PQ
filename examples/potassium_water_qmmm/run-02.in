#

# General Keywords
jobtype = qmmm-md;
nstep = 2500;
timestep = 0.5;
nreset = 5;
integrator = v-verlet;

# Thermostat
thermostat = berendsen;
t_relaxation = 0.1;
temp = 298.15;

# Manostat
manostat = berendsen;
pressure = 1.0;
p_relaxation = 0.5;
virial = molecular;

# MM Keywords
force-field = off;
rcoulomb= 15.0;
long_range = reaction_field;
rf_epsilon = 73.0;
water_intra = spc_fw;
water_inter = spc_fw;

# QM Keywords
qm_prog = dftbplus;
qm_script = dftbplus_periodic_stress;

# Hybrid MD Keywords
smoothing_method = exact;
core_radius = 0.0;
layer_radius = 3.8;
smoothing_region_thickness = 0.2;
point_charge_thickness = 15.0;

# File Keywords
start_file  = output-md-01.rst;
file_prefix = output-md-02;

