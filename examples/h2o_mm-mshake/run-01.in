# Water MM-MD with MShake enabled

    # Type of this run
      jobtype = mm-md;

    # Number of steps to be performed and timestep in fs
      nstep = 25000;
      timestep = 2.0;

    # Temperature coupling keys
      thermostat = velocity_rescaling;
      temp = 298.15;
      t_relaxation = 0.1;

    # Only apply GUFF formalism for intermolecular interactions
      force-field = off;
      rcoulomb    = 12.0;

    # MShake keywords for handling intramolecular interactions
      shake            = mshake;
    # Uncomment the following two keywords if the MShake algorithm has convergence issues
#      mshake-iter      = 100;
#      mshake_tolerance = 1e-6;

    # Input files
      start_file    = input.rst;
      topology_file = shake.top;
      mshake_file   = mshake.top;

    # Output files
      file_prefix = h2o-md-01;

